# ─── LLM provider ────────────────────────────────────────────────────────────
# Default provider used when no per-request override is sent: 'openai' | 'mistral'
LLM_PROVIDER=openai

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Mistral ─────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multiagent
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multiagent

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Invoicing ───────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/var/invoice_documents
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=10
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# ─── Extractor ───────────────────────────────────────────────────────────────
EXTRACTOR_IMAGE_SCALE=2.0
EXTRACTOR_IMAGE_DETAIL=high
EXTRACTOR_REQUEST_TIMEOUT_SECONDS=60
EXTRACTOR_MAX_RETRIES=3

# ─── Review (anomaly / validator / responder) ────────────────────────────────
REVIEW_AMOUNT_TOLERANCE=0.02
RESPONDER_MODEL=
RESPONDER_REQUEST_TIMEOUT_SECONDS=30
RESPONDER_MAX_RETRIES=3

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
